# ローカル開発用の例です。値はすべてダミーです。
# cp .env.example .env として使います(.env はGit管理外)。実際の鍵をこのファイルに書かないでください。
# docker compose は、このディレクトリの .env から PACKET_DEVICE_KEYS / PACKET_DISABLED_DEVICES を読みます。

# 署名なしの Emergency Packet v1 を受け付けるか。コード上のデフォルトは false。
# 開発: true(docker-compose.yml の既定も true)。デモ・本番: false(v1 の端末をすべて v2 に更新してから)。
# 移行の手順は docs/emergency-packet-v2.md の「v1からv2への移行手順と設定条件」。
ALLOW_V1_PACKETS=true

# Emergency Packet v2 の端末台帳: device_id -> {key_id: 鍵(16進で64文字(32バイト))}
# 下の鍵はダミーです。本番・実機では使わないでください。
PACKET_DEVICE_KEYS={"TB001":{"01":"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"}}

# PACKET_DEVICE_KEYS の代わりに、同じ形式のJSONファイル(秘密情報ファイル)のパスを指定することもできます。
# 両方を指定するとエラーになります。
# PACKET_DEVICE_KEYS_FILE=/run/secrets/packet_device_keys.json

# 無効化する端末の device_id(カンマ区切り)。無効な端末からのPacketは 403 PACKET_AUTH_FAILED になります。
PACKET_DISABLED_DEVICES=

# ---- クラウドへの配送(Outbox)。docs/outbox.md ----
# 有効にするのは true のときだけ(コード上のデフォルトは false)。宛先が空でも何もしない。
OUTBOX_ENABLED=false
# 宛先の一覧(JSON)。鍵そのものは書かず、key_env に鍵の環境変数の名前を書く。
OUTBOX_DESTINATIONS=[{"id":"cloud-sat","base_url":"https://example.invalid","key_env":"OUTBOX_KEY_CLOUD_SAT"}]
# 宛先 cloud-sat のGateway Key(ダミー値)。実際の値はここに書かない。
OUTBOX_KEY_CLOUD_SAT=dummy-outbox-gateway-key
# 以下はデモ用の暫定値。
OUTBOX_BATCH_SIZE=10
OUTBOX_HTTP_TIMEOUT_SECONDS=10
OUTBOX_LEASE_SECONDS=60
OUTBOX_PROBE_INTERVAL_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=2
# 宛先の状態(GET /api/destinations/status)の判定しきい値。デモ用の暫定値。
OUTBOX_STATUS_DOWN_SECONDS=120
OUTBOX_STATUS_DELAYED_LATENCY_MS=5000
OUTBOX_STATUS_DELAYED_PENDING_SECONDS=60
