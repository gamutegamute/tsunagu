# ローカル開発用の例です。値はすべてダミーです。
# cp .env.example .env として使います(.env はGit管理外)。実際の鍵をこのファイルに書かないでください。
# docker compose は、このディレクトリの .env から PACKET_DEVICE_KEYS / PACKET_DISABLED_DEVICES を読みます。

# 署名なしの Emergency Packet v1 を受け付けるか。コード上のデフォルトは false。
# 開発用の docker-compose.yml では true にしています。
ALLOW_V1_PACKETS=true

# Emergency Packet v2 の端末台帳: device_id -> {key_id: 鍵(16進、16バイト以上)}
# 下の鍵はダミーです。本番・実機では使わないでください。
PACKET_DEVICE_KEYS={"TB001":{"01":"00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff"}}

# PACKET_DEVICE_KEYS の代わりに、同じ形式のJSONファイル(秘密情報ファイル)のパスを指定することもできます。
# 両方を指定するとエラーになります。
# PACKET_DEVICE_KEYS_FILE=/run/secrets/packet_device_keys.json

# 無効化する端末の device_id(カンマ区切り)。無効な端末からのPacketは 403 PACKET_AUTH_FAILED になります。
PACKET_DISABLED_DEVICES=
